    "patch": "diff --git a/main.py b/main.py\nindex 0000000..1111111 100644\n--- a/main.py\n+++ b/main.py\n@@ -1,15 +1,33 @@\n-class School:\n-    def __init__(self):\n-        pass\n-\n-    def add_student(self, name: str, grade: int) -> None:\n-        pass\n-\n-    def roster(self) -> list[str]:\n-        pass\n-\n-    def grade(self, grade_number: int) -> list[str]:\n-        pass\n-\n-    def added(self) -> list[bool]:\n-        pass\n+class School:\n+    def __init__(self):\n+        self._roster = {}\n+        self._added = []\n+\n+    def add_student(self, name: str, grade: int) -> None:\n+        # Check if student already exists in any grade\n+        for students in self._roster.values():\n+            if name in students:\n+                self._added.append(False)\n+                return\n+        \n+        # Add student to the specified grade\n+        if grade not in self._roster:\n+            self._roster[grade] = []\n+        self._roster[grade].append(name)\n+        self._added.append(True)\n+\n+    def roster(self) -> list[str]:\n+        result = []\n+        # Sort grades numerically\n+        for grade in sorted(self._roster.keys()):\n+            # Sort students alphabetically within each grade\n+            result.extend(sorted(self._roster[grade]))\n+        return result\n+\n+    def grade(self, grade_number: int) -> list[str]:\n+        if grade_number in self._roster:\n+            return sorted(self._roster[grade_number])\n+        return []\n+\n+    def added(self) -> list[bool]:\n+        return self._added\n",
