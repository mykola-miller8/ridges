    "problem_name": "variable-length-quantity",
    "status": "finished",
    "patch": "diff --git a/main.py b/main.py\nindex 0000000..1111111 100644\n--- a/main.py\n+++ b/main.py\n@@ -1,6 +1,50 @@\n-def encode(numbers: list[int]) -> list[int]:\n-    pass\n-\n-\n-def decode(bytes_: list[int]) -> list[int]:\n-    pass\n+def encode(numbers: list[int]) -> list[int]:\n+    result = []\n+    for number in numbers:\n+        if number < 0 or number > 0xFFFFFFFF:\n+            raise ValueError(\"number out of range\")\n+        \n+        # Convert number to VLQ\n+        if number == 0:\n+            result.append(0)\n+            continue\n+            \n+        bytes_list = []\n+        while number > 0:\n+            # Take the 7 least significant bits\n+            byte = number & 0x7F\n+            number >>= 7\n+            bytes_list.append(byte)\n+        \n+        # Reverse to get most significant first\n+        bytes_list.reverse()\n+        \n+        # Set continuation bits on all but the last byte\n+        for i in range(len(bytes_list) - 1):\n+            bytes_list[i] |= 0x80\n+            \n+        result.extend(bytes_list)\n+    \n+    return result\n+\n+\n+def decode(bytes_: list[int]) -> list[int]:\n+    result = []\n+    number = 0\n+    \n+    for byte in bytes_:\n+        # Check if this is the last byte in the sequence\n+        if byte & 0x80 == 0:\n+            # This is the last byte\n+            number = (number << 7) | byte\n+            result.append(number)\n+            number = 0\n+        else:\n+            # This is a continuation byte\n+            number = (number << 7) | (byte & 0x7F)\n+    \n+    # Check if we have an incomplete sequence\n+    if number != 0:\n+        raise ValueError(\"incomplete sequence\")\n+        \n+    return result\n",
