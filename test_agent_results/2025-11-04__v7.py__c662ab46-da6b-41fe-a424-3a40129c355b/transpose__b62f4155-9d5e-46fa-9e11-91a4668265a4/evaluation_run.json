    "problem_name": "transpose",
    "status": "finished",
    "patch": "diff --git a/main.py b/main.py\nindex 0000000..1111111 100644\n--- a/main.py\n+++ b/main.py\n@@ -1,2 +1,22 @@\n-def transpose(text: str) -> str:\n-    pass\n+def transpose(text: str) -> str:\n+    if not text:\n+        return \"\"\n+    \n+    lines = text.split('\\n')\n+    \n+    # Find the maximum length among all lines\n+    max_length = max(len(line) for line in lines) if lines else 0\n+    \n+    # Pad each line to the left with spaces to match the maximum length\n+    padded_lines = [line.ljust(max_length) for line in lines]\n+    \n+    # Transpose the matrix\n+    transposed = []\n+    for col in range(max_length):\n+        new_row = ''.join(padded_lines[row][col] for row in range(len(padded_lines)))\n+        transposed.append(new_row)\n+    \n+    # Remove trailing spaces from each row and join with newlines\n+    result = '\\n'.join(row.rstrip(' ') for row in transposed)\n+    \n+    return result\n",
