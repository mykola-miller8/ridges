    "patch": "diff --git a/main.py b/main.py\nindex 0000000..1111111 100644\n--- a/main.py\n+++ b/main.py\n@@ -1,9 +1,46 @@\n-class BowlingGame:\n-    def __init__(self):\n-        pass\n-\n-    def roll(self, pins):\n-        pass\n-\n-    def score(self):\n-        pass\n+class BowlingGame:\n+    def __init__(self):\n+        self.rolls = []\n+        self.current_roll = 0\n+\n+    def roll(self, pins):\n+        if pins < 0:\n+            raise ValueError(\"Negative roll is invalid\")\n+        if pins > 10:\n+            raise ValueError(\"Pin count exceeds pins on the lane\")\n+        self.rolls.append(pins)\n+\n+    def score(self):\n+        score = 0\n+        frame_index = 0\n+        \n+        for frame in range(10):\n+            if frame_index >= len(self.rolls):\n+                raise IndexError(\"Not enough rolls\")\n+                \n+            if self._is_strike(frame_index):\n+                if frame_index + 2 >= len(self.rolls):\n+                    raise IndexError(\"Not enough rolls for strike bonus\")\n+                score += 10 + self.rolls[frame_index + 1] + self.rolls[frame_index + 2]\n+                frame_index += 1\n+            elif self._is_spare(frame_index):\n+                if frame_index + 2 >= len(self.rolls):\n+                    raise IndexError(\"Not enough rolls for spare bonus\")\n+                score += 10 + self.rolls[frame_index + 2]\n+                frame_index += 2\n+            else:\n+                if frame_index + 1 >= len(self.rolls):\n+                    raise IndexError(\"Not enough rolls\")\n+                score += self.rolls[frame_index] + self.rolls[frame_index + 1]\n+                frame_index += 2\n+                \n+        if frame_index < len(self.rolls):\n+            raise ValueError(\"Cannot roll after game is over\")\n+            \n+        return score\n+\n+    def _is_strike(self, frame_index):\n+        return self.rolls[frame_index] == 10\n+\n+    def _is_spare(self, frame_index):\n+        return self.rolls[frame_index] + self.rolls[frame_index + 1] == 10\n",
