    "patch": "diff --git a/main.py b/main.py\nindex 0000000..1111111 100644\n--- a/main.py\n+++ b/main.py\n@@ -1,2 +1,27 @@\n-def translate(text: str) -> str:\n-    pass\n+def translate(text: str) -> str:\n+    def pig_latin_word(word: str) -> str:\n+        vowels = \"aeiou\"\n+        \n+        # Rule 1: starts with vowel or \"xr\" or \"yt\"\n+        if word[0] in vowels or word.startswith(\"xr\") or word.startswith(\"yt\"):\n+            return word + \"ay\"\n+        \n+        # Find the index where the consonant cluster ends\n+        i = 0\n+        while i < len(word):\n+            # Rule 3: if we encounter \"qu\", move everything up to and including \"qu\"\n+            if i < len(word) - 1 and word[i:i+2] == \"qu\":\n+                i += 2\n+                break\n+            # Rule 4: if we encounter \"y\" after consonants, stop before \"y\"\n+            elif word[i] == \"y\" and i > 0:\n+                break\n+            # If it's a vowel (but not the special cases above), stop\n+            elif word[i] in vowels:\n+                break\n+            i += 1\n+        \n+        # Move the consonant cluster (or consonants + \"qu\") to the end and add \"ay\"\n+        return word[i:] + word[:i] + \"ay\"\n+    \n+    return \" \".join(pig_latin_word(word) for word in text.split())\n",
