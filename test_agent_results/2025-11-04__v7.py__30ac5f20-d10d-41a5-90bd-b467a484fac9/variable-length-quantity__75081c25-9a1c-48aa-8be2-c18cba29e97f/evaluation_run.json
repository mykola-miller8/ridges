    "problem_name": "variable-length-quantity",
    "status": "finished",
    "patch": "diff --git a/main.py b/main.py\nindex 0000000..1111111 100644\n--- a/main.py\n+++ b/main.py\n@@ -1,6 +1,51 @@\n-def encode(numbers: list[int]) -> list[int]:\n-    pass\n-\n-\n-def decode(bytes_: list[int]) -> list[int]:\n-    pass\n+def encode(numbers: list[int]) -> list[int]:\n+    result = []\n+    for number in numbers:\n+        if number < 0 or number > 0xFFFFFFFF:\n+            raise ValueError(\"number out of range\")\n+        \n+        # Convert number to VLQ\n+        if number == 0:\n+            result.append(0)\n+            continue\n+            \n+        bytes_list = []\n+        while number > 0:\n+            byte = number & 0x7F\n+            number >>= 7\n+            if bytes_list:\n+                byte |= 0x80\n+            bytes_list.append(byte)\n+        \n+        # Reverse to get most significant byte first\n+        result.extend(reversed(bytes_list))\n+    \n+    return result\n+\n+\n+def decode(bytes_: list[int]) -> list[int]:\n+    result = []\n+    number = 0\n+    \n+    for byte in bytes_:\n+        if byte < 0 or byte > 0xFF:\n+            raise ValueError(\"invalid byte\")\n+            \n+        # Add 7 bits to our number\n+        number = (number << 7) | (byte & 0x7F)\n+        \n+        # If MSB is not set, this is the last byte of the number\n+        if (byte & 0x80) == 0:\n+            if number > 0xFFFFFFFF:\n+                raise ValueError(\"number out of range\")\n+            result.append(number)\n+            number = 0\n+        elif len(result) >= len(bytes_) - 1 and (byte & 0x80) != 0:\n+            # Check if we have an incomplete sequence\n+            raise ValueError(\"incomplete sequence\")\n+    \n+    # Check if we have an incomplete sequence at the end\n+    if number != 0:\n+        raise ValueError(\"incomplete sequence\")\n+        \n+    return result\n",
