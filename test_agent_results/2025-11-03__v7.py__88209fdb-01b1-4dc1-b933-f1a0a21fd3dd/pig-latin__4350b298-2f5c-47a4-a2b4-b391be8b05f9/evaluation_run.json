    "problem_name": "pig-latin",
    "status": "finished",
    "patch": "diff --git a/main.py b/main.py\nindex 0000000..1111111 100644\n--- a/main.py\n+++ b/main.py\n@@ -1,2 +1,28 @@\n-def translate(text: str) -> str:\n-    pass\n+def translate(text: str) -> str:\n+    def pig_latin_word(word: str) -> str:\n+        # Rule 1: If word begins with a vowel sound, add \"ay\" to the end\n+        # Also handles special cases \"xr\" and \"yt\"\n+        if word.startswith(('a', 'e', 'i', 'o', 'u')) or word.startswith(('xr', 'yt')):\n+            return word + 'ay'\n+        \n+        # Find the index where the consonant cluster ends\n+        i = 0\n+        while i < len(word):\n+            # Rule 3: If we encounter \"qu\", move everything up to and including \"qu\"\n+            if i < len(word) - 1 and word[i:i+2] == 'qu':\n+                i += 2  # Move past the 'qu'\n+                break\n+            # Rule 4: If we encounter 'y' after consonants, treat 'y' as a vowel\n+            elif word[i] == 'y' and i > 0:\n+                break\n+            # If we hit a vowel (except 'y' at the beginning), stop\n+            elif word[i] in 'aeiou':\n+                break\n+            # Continue moving through consonants\n+            i += 1\n+        \n+        # Move the consonant cluster to the end and add \"ay\"\n+        return word[i:] + word[:i] + 'ay'\n+    \n+    # Split the text into words, translate each word, and rejoin\n+    return ' '.join(pig_latin_word(word) for word in text.split())\n",
